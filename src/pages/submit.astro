---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit a Module — ConvexCompose">
  <section class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Submit a module</h1>
    <p class="text-neutral-400 mb-10">Built something Convex-native that other developers should know about? We curate ConvexCompose around quality and composability — tell us what you've made.</p>

    <form class="space-y-5" action="mailto:nakul@convex.store" method="post" enctype="text/plain">
      <div>
        <label class="block text-sm text-neutral-300 mb-1.5">Module name</label>
        <input name="name" type="text" required class="w-full px-3 py-2 rounded-md bg-neutral-900 border border-neutral-800 focus:border-violet-500 focus:outline-none text-white" />
      </div>
      <div>
        <label class="block text-sm text-neutral-300 mb-1.5">Your email</label>
        <input name="email" type="email" required class="w-full px-3 py-2 rounded-md bg-neutral-900 border border-neutral-800 focus:border-violet-500 focus:outline-none text-white" />
      </div>
      <div>
        <label class="block text-sm text-neutral-300 mb-1.5">GitHub repo (optional)</label>
        <input name="repo" type="url" class="w-full px-3 py-2 rounded-md bg-neutral-900 border border-neutral-800 focus:border-violet-500 focus:outline-none text-white" />
      </div>
      <div>
        <label class="block text-sm text-neutral-300 mb-1.5">What does it do?</label>
        <textarea name="description" rows="5" required class="w-full px-3 py-2 rounded-md bg-neutral-900 border border-neutral-800 focus:border-violet-500 focus:outline-none text-white"></textarea>
      </div>
      <button type="submit" class="px-5 py-2.5 rounded-md bg-violet-500 hover:bg-violet-400 text-white font-medium transition-colors">
        Submit module
      </button>
      <p class="text-xs text-neutral-500">Form submission opens your mail client. Real form coming soon.</p>
    </form>
  </section>
</BaseLayout>
