---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  { href: '/docs/architecture', title: 'The module contract', desc: 'MUST / MUST NOT / OPTIONAL, the three-layer model, and what makes something a ConvexCompose module.' },
  { href: '/docs/getting-started', title: 'Getting started', desc: 'Install a module with app.use(), use its headless hook, and write a five-line route wrapper.' },
  { href: '/submit', title: 'Conformance checklist', desc: 'The contract made actionable for third-party module authors.' },
];
---

<BaseLayout title="Docs : ConvexCompose">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-24">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Documentation</h1>
    <p class="text-neutral-400 mb-4 max-w-2xl">ConvexCompose is opinionated about the module contract and unopinionated about the host app. These docs teach the contract: how a module is shaped, so it composes and ports, while forcing nothing on your framework, router, styling, or platform.</p>
    <p class="text-sm text-neutral-500 mb-12 max-w-2xl">Honest status: no module is a published, installable package yet. convex-garden is the first in extraction and the worked example throughout.</p>
    <div class="grid md:grid-cols-2 gap-5">
      {sections.map((s) => (
        <a href={s.href} class="group p-6 rounded-xl border border-neutral-800 bg-neutral-900/40 hover:border-violet-500/40 transition-colors">
          <h2 class="text-lg font-semibold text-white mb-1 group-hover:text-violet-300">{s.title}</h2>
          <p class="text-sm text-neutral-400">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
