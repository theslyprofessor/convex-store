---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { modules, statusLabels, statusClasses, categoryLabels } from '../../data/modules';

export async function getStaticPaths() {
  return modules.map((m) => ({ params: { slug: m.slug }, props: { module: m } }));
}

const { module } = Astro.props;
// Nothing is a published, installable package yet. The future install shape is shown,
// but framed honestly as not-yet-available.
const futureInstall = `app.use(${module.slug.replace('convex-', '')})`;
---

<BaseLayout title={`${module.name} : ConvexCompose`} description={module.tagline}>
  <article class="max-w-4xl mx-auto px-6 pt-16 pb-24">
    <a href="/modules" class="text-sm text-neutral-400 hover:text-white inline-flex items-center gap-1 mb-8">← All modules</a>

    <div class="flex items-start gap-5 mb-6">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-violet-500/30 to-blue-500/30 border border-violet-500/40 flex items-center justify-center text-2xl font-bold text-violet-200 shrink-0">
        {module.name.charAt(0)}
      </div>
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-2">
          <h1 class="text-4xl font-bold text-white">{module.name}</h1>
          <span class={`text-xs px-2 py-0.5 rounded-full border ${statusClasses[module.status]}`}>
            {statusLabels[module.status]}
          </span>
          <span class="text-xs px-2 py-0.5 rounded-full border border-neutral-800 text-neutral-400">
            {categoryLabels[module.category]}
          </span>
        </div>
        <p class="text-lg text-neutral-400">{module.tagline}</p>
      </div>
    </div>

    <!-- Future install shape (honest: not installable yet) -->
    <div class="rounded-lg border border-neutral-800 bg-neutral-900/60 p-4 mb-10 flex items-center justify-between gap-4">
      <code class="text-sm text-violet-300 font-mono truncate">{futureInstall}</code>
      <span class="text-xs text-neutral-500 shrink-0">Future install shape; not yet published</span>
    </div>

    <!-- Description -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold text-white mb-3">About</h2>
      <p class="text-neutral-300 leading-relaxed">{module.description}</p>
    </section>

    <!-- How it ships (the three-part contract shape) -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold text-white mb-4">How it ships</h2>
      <p class="text-sm text-neutral-400 mb-4">Every ConvexCompose module is the same shape. Take the Component and hooks and bring your own UI, or drop in the optional reference UI.</p>
      <div class="grid gap-3 md:grid-cols-3">
        <div class="p-4 rounded-lg border border-emerald-500/30 bg-emerald-500/5">
          <div class="text-xs font-mono text-emerald-300 mb-1.5">Layer 1 · MUST</div>
          <div class="text-sm text-neutral-300">{module.delivery.component}</div>
        </div>
        <div class="p-4 rounded-lg border border-blue-500/30 bg-blue-500/5">
          <div class="text-xs font-mono text-blue-300 mb-1.5">Layer 2 · MUST</div>
          <div class="text-sm text-neutral-300">{module.delivery.hooks}</div>
        </div>
        <div class="p-4 rounded-lg border border-violet-500/30 bg-violet-500/5">
          <div class="text-xs font-mono text-violet-300 mb-1.5">Layer 3 · OPTIONAL</div>
          <div class="text-sm text-neutral-300">{module.delivery.referenceUi}</div>
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold text-white mb-4">Highlights</h2>
      <ul class="space-y-2">
        {module.highlights.map((h) => (
          <li class="flex items-start gap-3 text-neutral-300">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-violet-400 shrink-0"></span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Proving ground -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold text-white mb-4">Proving ground</h2>
      <p class="text-sm text-neutral-400 mb-4">A real production deployment exercises these domains; one opinionated consumer, not a requirement.</p>
      <div class="inline-flex items-center gap-3 p-4 rounded-lg border border-neutral-800 bg-neutral-900/40">
        <div class="w-10 h-10 rounded-md bg-gradient-to-br from-violet-500/40 to-blue-500/40 border border-violet-500/40 flex items-center justify-center text-violet-200 font-bold">{module.name.charAt(0)}</div>
        <div>
          <div class="font-semibold text-white">A real production deployment</div>
          <div class="text-xs text-neutral-400">50+ portals on one Convex deployment</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="rounded-xl border border-violet-500/30 bg-violet-500/5 p-6 text-center">
      <h3 class="text-lg font-semibold text-white mb-2">Not a published package yet</h3>
      <p class="text-sm text-neutral-400 mb-4">No ConvexCompose module is an installable npm package today. What exists is the contract, a real production proving ground, and convex-garden as the first module in extraction.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/docs/architecture" class="inline-block px-5 py-2.5 rounded-md bg-violet-500 hover:bg-violet-400 text-white font-medium transition-colors">
          Read the contract
        </a>
        <a
          href={`mailto:nakul@convex.store?subject=Notify%20me:%20${encodeURIComponent(module.name)}&body=Please%20notify%20me%20when%20${encodeURIComponent(module.name)}%20is%20extracted.`}
          class="inline-block px-5 py-2.5 rounded-md border border-neutral-800 hover:bg-neutral-900 text-neutral-200 font-medium transition-colors"
        >
          Notify me when it ships
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
