---
const layers = [
  { num: 4, title: 'Your App', desc: 'Routes, layouts, your business logic', color: 'from-violet-500/30 to-violet-500/10', border: 'border-violet-500/40' },
  { num: 3, title: 'ConvexCompose Modules', desc: 'Mail · Tasks · LMS · Inventory · Booking · …', color: 'from-blue-500/30 to-blue-500/10', border: 'border-blue-500/40' },
  { num: 2, title: 'Convex Components', desc: 'Rate Limiter · Workflow · Crons · Aggregate', color: 'from-emerald-500/25 to-emerald-500/10', border: 'border-emerald-500/40' },
  { num: 1, title: 'Convex Core', desc: 'Reactive database, functions, auth, scheduling', color: 'from-neutral-500/25 to-neutral-500/10', border: 'border-neutral-500/40' },
];
---

<div class="space-y-2 max-w-2xl mx-auto">
  {layers.map((l) => (
    <div class={`rounded-lg border ${l.border} bg-gradient-to-r ${l.color} px-5 py-4 flex items-center gap-4`}>
      <div class="w-8 h-8 rounded-md bg-neutral-950/60 border border-white/10 flex items-center justify-center text-xs font-mono text-neutral-300">
        L{l.num}
      </div>
      <div class="flex-1">
        <div class="font-semibold text-white">{l.title}</div>
        <div class="text-xs text-neutral-300/80">{l.desc}</div>
      </div>
    </div>
  ))}
</div>
